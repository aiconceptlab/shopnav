{
  "name": "shopnav",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3023",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3023",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "instagram": "node marketing/render.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/qrcode": "1.5.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "@napi-rs/canvas": "1.0.11",
    "playwright": "1.64.1"
  }
}
